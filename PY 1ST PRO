      "source": [
        "class MoodPredictor:\n",
        "    \"\"\"\n",
        "    A production-style class for handling mood prediction using a trained MoodClassifier.\n",
        "    \"\"\"\n",
        "    def __init__(self, model, label_encoder):\n",
        "        self.device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "        self.model = model.to(self.device)\n",
        "        self.label_encoder = label_encoder\n",
        "\n",
        "    def predict(self, features):\n",
        "        \"\"\"\n",
        "        Predicts the mood label for a given set of numerical features.\n",
        "        \"\"\"\n",
        "        # a. Convert input features into a PyTorch tensor\n",
        "        input_tensor = torch.tensor([features], dtype=torch.float32)\n",
        "\n",
        "        # b. Move the tensor to the configured device\n",
        "        input_tensor = input_tensor.to(self.device)\n",
        "\n",
        "        # c. Set model to evaluation mode and use torch.no_grad()\n",
        "        self.model.eval()\n",
        "        with torch.no_grad():\n",
        "            # d. Forward pass, softmax, and find class index\n",
        "            outputs = self.model(input_tensor)\n",
        "            probabilities = torch.softmax(outputs, dim=1)\n",
        "            predicted_index = torch.argmax(probabilities, dim=1).item()\n",
        "\n",
        "        # e. Convert index back to mood string\n",
        "        predicted_mood = self.label_encoder.inverse_transform([predicted_index])[0]\n",
        "        return predicted_mood\n",
        "\n",
        "# Instantiate MoodPredictor to verify functionality\n",
        "predictor = MoodPredictor(model, label_encoder)\n",
        "\n",
        "# Quick test with sample features\n",
        "sample_features = [5.0, 3000.0, 120.0, 0.8, 15.0]\n",
        "result = predictor.predict(sample_features)\n",
        "print(f\"Predictor instantiated. Test prediction for {sample_features}: {result}\")"
      ],
