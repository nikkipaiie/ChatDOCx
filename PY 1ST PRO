        "data = []\n",
        "for mood in MOODS:\n",
        "    for _ in range(NUM_SAMPLES_PER_MOOD):\n",
        "        features = np.random.rand(NUM_FEATURES)\n",
        "        if mood == 'happy':\n",
        "            features = [np.random.uniform(5, 10), np.random.uniform(2000, 4000), np.random.uniform(100, 150), np.random.uniform(0.7, 1.0), np.random.uniform(10, 20)]\n",
        "        elif mood == 'sad':\n",
        "            features = [np.random.uniform(0.5, 3), np.random.uniform(500, 2000), np.random.uniform(50, 90), np.random.uniform(0.0, 0.3), np.random.uniform(-5, 5)]\n",
