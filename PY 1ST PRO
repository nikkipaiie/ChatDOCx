        "### 3. Define the PyTorch Model\n",
        "\n",
        "We'll create a simple feedforward neural network for mood classification. This model will take our 5 audio features as input and output probabilities for each of our 4 mood categories."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "bc9ffa47",
        "outputId": "a670ab34-637a-46ac-bd68-1ae678458fa7"
      },
      "source": [
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "# Define the neural network\n",
        "class MoodClassifier(nn.Module):\n",
        "    def __init__(self, num_features, num_moods):\n",
        "        super(MoodClassifier, self).__init__()\n",
        "        self.fc1 = nn.Linear(num_features, 64) # First hidden layer\n",
        "        self.fc2 = nn.Linear(64, 32)            # Second hidden layer\n",
        "        self.fc3 = nn.Linear(32, num_moods)     # Output layer\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = F.relu(self.fc1(x))\n",
        "        x = F.relu(self.fc2(x))\n",
        "        x = self.fc3(x) # No activation here, as we'll use CrossEntropyLoss which includes softmax\n",
        "        return x\n",
        "\n",
        "# Instantiate the model\n",
        "num_features = X.shape[1]\n",
        "num_moods = len(label_encoder.classes_)\n",
        "model = MoodClassifier(num_features, num_moods)\n",
        "\n",
        "print(model)"
